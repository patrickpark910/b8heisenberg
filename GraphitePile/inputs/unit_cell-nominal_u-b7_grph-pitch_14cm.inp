  m601   6012.00c 9.892964e-01   $ C-12
         6013.00c 1.069996e-02   $ C-13
         5010.00c 6.964975e-07   $ B-10
         5011.00c 2.803490e-06   $ B-11
        48110.00c 1.248996e-08   $ Cd-110
        48111.00c 1.279995e-08   $ Cd-111
        48112.00c 2.412991e-08   $ Cd-112
        48113.00c 1.221996e-08   $ Cd-113
        48114.00c 2.872990e-08   $ Cd-114
        48116.00c 7.489973e-09   $ Cd-116
