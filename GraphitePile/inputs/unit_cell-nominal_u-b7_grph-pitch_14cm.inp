c Default MCNP units
c Length: cm
c Mass: g
c Energy & Temp.: MeV
c Positive density (+x): atoms/barn-cm
c Negative density (-x): g/cm3
c
c
c       CELL CARDS ************************************************************
c
  9     0                 +20   imp:n=0 $ void
  1     100  -19.01   -10       imp:n=1 $ uranium
  2     601   -1.70   +10 -20   imp:n=1 $ graphite
c
c       ***********************************************************************
c

c
c       SURFACE CARDS *********************************************************
c 
  10    rpp   -2.5  +2.5   -2.5  +2.5   -2.5  +2.5   $ uranium cube
 *20    rpp   -7.0  +7.0   -7.0  +7.0   -7.0  +7.0   $ graphite cube (reflected)
c
c       ***********************************************************************
c

c
c       DATA CARDS ************************************************************
