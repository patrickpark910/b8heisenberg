Koester NU-SEG Pile
c
c Patrick Park
c pjp2136@columbia.edu
c
c __________________
c Default MCNP units
c Length: cm
c Mass: g
c Energy & Temp.: MeV
c Positive density (+x): atoms/barn-cm
c Negative density (-x): g/cm3
c
c
c --Begin Cells--
c
9     0  #2 #1 imp:n=0 $ void
1 10001  -19.01  +11 -12 +13 -14 +15 -16  imp:n=1 $ NU cube
2 10602   -1.70  +21 -22 +23 -24 +25 -26      
                 (-11:+12:-13:+14:-15:+16)  imp:n=1 $ siemens electrographite
c
c

c
c --Begin Surfaces--
c 10 = uranium / 20 = graphite
c
11 px -2.5  
12 px  2.5 
13 py -2.5 
14 py  2.5 
15 pz -2.5 
16 pz  2.5 
c
*21 px -10.0
*22 px +10.0
*23 py -10.0
*24 py +10.0
*25 pz -10.0
*26 pz +10.0
c

c --Begin Options--
c
c -- NU Cube from Degussa -- 18.53 g/cc --
c Density from PNNL / 7.1 ppm EBC by mass from Pesic 18
c Uranium atom fracs from Sandia Nat Lab "MatMCNP code" SAND2014-17693
c
m10001    92238.80c  -0.99287891
          92235.80c  -0.00711399
c           5010.80c  -0.00000131
c           5011.80c  -0.00000579
c
c MCNP6.2 does not support S(a,b) for fissionable material
c
c
c -- Siemens Electro-Graphite -- 1.70 g/cc --
c  At fracs from Hanle 41
c  +at frac -mass frac
c
m10602    6012.00c  0.9894         6013.00c  0.0106       $ C-12 C-13
c          5010.00c  0.0000040     5010.00c  0.0000010
c          5011.00c  0.000004821    5010.00c  0.000001179  $ B-11 B-10
c                                  48000.50c  0.0000001    $ Cd (.50c ENDF/V)
c
mt10602   grph.40t
c
c
ksrc 0 0 0
c
c nps 1e+6
mode n
kcode 200000 1 15 115
kopts blocksize=10 kinetics=yes precursor=yes
c